{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lightsaber: web",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--web"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Lightsaber: web (diagnostics)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--web", "--diag"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: current file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
